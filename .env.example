# Airflow (local development)
AIRFLOW_BASE_URL=http://127.0.0.1:38000
AIRFLOW_SESSION_COOKIE=

# CloudWatch (future)
AWS_REGION=eu-west-1

# Backend
CACHE_TTL_SECONDS=30

# Frontend
# Serves stub data while the backend /services endpoints are unimplemented.
# Set to false to fetch from API_BASE_URL instead.
USE_STUB_DATA=true
API_BASE_URL=http://localhost:8080
